{
    "name": "terminal-output-clipboard",
    "displayName": "Terminal Output Clipboard",
    "description": "Collect terminal output into batches and copy it with one command.",
    "version": "0.1.0",
    "publisher": "local-development",
    "private": true,
    "engines": {
        "vscode": "^1.108.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],

    "contributes": {
    "commands": [
        {
        "command": "terminalOutputClipboard.copyLatest",
        "title": "Terminal Output Clipboard: Copy Latest"
        },
        {
        "command": "terminalOutputClipboard.clear",
        "title": "Terminal Output Clipboard: Clear Buffer"
        }
    ],
    "keybindings": [
        {
        "command": "terminalOutputClipboard.copyLatest",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c"
        }
    ]
    },

    "scripts": {
        "compile": "tsc -p . && esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
        "check-types": "tsc -p . --noEmit",
        "test": "npm run compile && node --test tests/*.test.cjs",
        "vscode:prepublish": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.108.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "esbuild": "^0.28.2",
        "typescript": "^7.0.2"
    }
}
